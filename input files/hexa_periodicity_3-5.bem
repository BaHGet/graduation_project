// hexagonl lattice
//  xre = yre ,  phi = 60

eV=1/27.2113834
AA=1/0.529177208
meff 0.41
Ei 0.015*eV
potential 1 0*eV      0  // potential outside circle.
potential 2 0.7*eV      0  // potential inside circle.

a=7*AA        // circle radius
b=7*AA
n=500
m1=1
m2=2
theta_D=180 // unused
theta_R=pi/3

d=35*AA

xre=d        // superstructure period in X-D
yre=d        // superstructure period in Y-D

x=-0.5*xre         //(x,y) periodicity origin
y=-0.5*yre*sin(theta_R)

add-arc-boundary m2 m1 0*AA 0*AA a b 0 0 360 n

repeat-periodic-geometry 1*xre 1*yre 0 60 150
//write-geometry data/hexagon_lattice_geo.dat
//write-regions 350 data/hexagon_lattice_reg.dat
//end
/// ||||||||||||||||||||||||||
periodicity 0 0 xre yre 0 60 70 70

nEnd=1.7*eV

///// Band structure along Gamma-M /////
qx0=0
qy0=0
qx1=0
qy1=0.3
//BANDS 7 qx0 qy0 qx1 qy1 350 nEnd data/hexa_m_1.dat

///// Band structure along Gamma-K /////
qx0=0
qy0=0
qx1=0.3
qy1=0.0
//BANDS 7 qx0 qy0 qx1 qy1 150 nEnd data/hexa_k_1.dat

///// Band structure along Gamma-M-K-Gamma /////
BANDS-hexagonal 7 500 0.8*eV data/hexa_mk_0-7_3-5nm.dat
end
// Calculate PE intensities along the segment going from                 
      //(qx0,qy0) to (qx1,qy1) 

qx0=-0
qy0=0.5/AA
qx1=0
qy1=-0.5/AA

//PE-qE-EPW 7 qx0 qy0 qx1 qy1 250 0.0*eV 0.8*eV 250 data/Hex_GM_PE.dat

///// Constant Energy Surface (CES) /////
qx0=-1.5*(4*pi/(3*xre))
qy0=qx0
dqx=-2*qx0
dqy=-2*qy0

//PE-qxqy-EPW 7 qx0 qy0 dqx dqy 0.12*eV 120 120 data/hexa_ces_0-1651.dat

//////////////LDOS at a point///////////////// local density of state

// abc triangle a bottom left, c bottom right

ax=0
ay=0
bx=xre/2
by=0
cx=0
cy=sin(theta_R)*yre

red_point_x=(ax+bx+cx)/3
red_point_y=(ay+by+cy)/3
black_point_x=(ax+bx+cx)/3
black_point_y=-(ay+by+cy)/3

//LDOS-rE-EPW 5 red_point_x red_point_y red_point_x red_point_y 1 0 0.7*eV 120 data/hex_LDOS_0-7_red_point.dat


//////////////2D_DOS_finite/////////////////

//LDOS-xy-EPW  5 -10 -23  2.5*xre 2.5*xre  0.3176*eV 60 60  data/hex_LDOS_0-7_3176.dat

end